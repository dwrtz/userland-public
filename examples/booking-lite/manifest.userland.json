{
  "app": {
    "name": "Booking Lite",
    "summary": "Book open time slots, one booking per slot.",
    "visibility": "public",
    "tags": ["booking", "data"]
  },
  "runtime": {
    "static_root": "public",
    "server_entry": "server/index.js",
    "fallback": "server"
  },
  "resources": {
    "data": {
      "collections": {
        "slots": {
          "fields": {
            "title": "string",
            "starts_at": "datetime",
            "status": {
              "type": "enum",
              "values": ["available", "booked"]
            },
            "booked_by": "string"
          },
          "indexes": [
            {
              "name": "by_status",
              "fields": ["status", "starts_at"]
            },
            {
              "name": "by_time",
              "fields": ["starts_at", "title"],
              "unique": true
            }
          ],
          "access": {
            "read": "public",
            "write": "server_only"
          }
        },
        "bookings": {
          "fields": {
            "slot_id": "string",
            "name": "string",
            "email": "string",
            "status": {
              "type": "enum",
              "values": ["confirmed"]
            }
          },
          "indexes": [
            {
              "name": "by_slot",
              "fields": ["slot_id"],
              "unique": true
            },
            {
              "name": "by_email",
              "fields": ["email"]
            }
          ],
          "access": {
            "read": "server_only",
            "write": "server_only"
          }
        }
      }
    }
  }
}

