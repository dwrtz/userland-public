{
  "name": "native-notes",
  "main": "worker.js",
  "compatibility_date": "2026-05-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notes",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "attachments"
    }
  ]
}
