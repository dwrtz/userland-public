{
  "app": {
    "name": "Velto Waitlist",
    "summary": "Pre-launch waitlist with referral positions, optional questions, and an owner view.",
    "visibility": "public",
    "tags": ["waitlist", "startup", "referrals"]
  },
  "runtime": {
    "static_root": "public",
    "server_entry": "server/index.js",
    "fallback": "server"
  },
  "resources": {
    "auth": {
      "mode": "app_users",
      "roles": ["owner"],
      "public_signup": false
    },
    "data": {
      "collections": {
        "signups": {
          "fields": {
            "email": "string",
            "name": "string",
            "status": {
              "type": "enum",
              "values": ["waiting", "invited", "archived"]
            },
            "joined_at": "datetime",
            "invited_at": "datetime",
            "referral_code": "string",
            "referred_by": "string",
            "status_token": "string",
            "frequency": "string",
            "goal": "string",
            "city": "string",
            "source": "string"
          },
          "indexes": [
            { "name": "by_email", "fields": ["email"], "unique": true },
            { "name": "by_referral_code", "fields": ["referral_code"], "unique": true }
          ],
          "access": {
            "read": "server_only",
            "write": "server_only"
          }
        },
        "demo-signups": {
          "fields": {
            "demo_key": "string",
            "demo_expires_at": "datetime",
            "email": "string",
            "name": "string",
            "status": {
              "type": "enum",
              "values": ["waiting", "invited", "archived"]
            },
            "joined_at": "datetime",
            "invited_at": "datetime",
            "referral_code": "string",
            "referred_by": "string",
            "status_token": "string",
            "frequency": "string",
            "goal": "string",
            "city": "string",
            "source": "string"
          },
          "indexes": [
            { "name": "by_demo_key_email", "fields": ["demo_key", "email"], "unique": true },
            { "name": "by_demo_expires_at", "fields": ["demo_expires_at"] }
          ],
          "access": {
            "read": "server_only",
            "write": "server_only"
          }
        }
      }
    }
  }
}
