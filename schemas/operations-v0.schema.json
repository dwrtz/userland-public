{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.userland.fun/schemas/operations-v0.schema.json",
  "title": "Userland CLI operation inventory",
  "description": "Every public CLI operation, its inputs, the API routes it calls and its MCP counterpart.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "cli_source",
    "environment",
    "operations"
  ],
  "properties": {
    "$schema": {
      "const": "https://docs.userland.fun/schemas/operations-v0.schema.json"
    },
    "version": {
      "const": "v0"
    },
    "cli_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_version",
        "public_commit"
      ],
      "properties": {
        "cli_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "public_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^USERLAND_[A-Z_]+$"
          },
          "role": {
            "enum": [
              "account",
              "interface",
              "local_credential"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "kind",
          "effect",
          "summary",
          "cli",
          "inputs",
          "api",
          "permission",
          "safeguards",
          "mcp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "area": {
            "enum": [
              "auth",
              "api_keys",
              "accounts",
              "support",
              "validation",
              "apps",
              "secrets",
              "app_users",
              "observation",
              "routes",
              "recovery"
            ]
          },
          "kind": {
            "enum": [
              "api",
              "local",
              "local_credential"
            ]
          },
          "effect": {
            "enum": [
              "read",
              "write",
              "destructive",
              "local"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "cli": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "aliases",
              "status"
            ],
            "properties": {
              "command": {
                "type": "string",
                "pattern": "^[a-z][a-z -]*[a-z]$"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z -]*[a-z]$"
                }
              },
              "status": {
                "enum": [
                  "released",
                  "planned"
                ]
              }
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cli",
                "source",
                "required",
                "takes_value",
                "role",
                "description"
              ],
              "properties": {
                "cli": {
                  "type": "string",
                  "pattern": "^(<[A-Za-z][A-Za-z-]*>|\\[[A-Za-z][A-Za-z-]*\\]|--[a-z][a-z-]*|stdin)$"
                },
                "source": {
                  "enum": [
                    "argument",
                    "flag",
                    "stdin"
                  ]
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(-[a-z]|--[a-z][a-z-]*(=[a-z]+)?)$"
                  }
                },
                "required": {
                  "type": "boolean"
                },
                "takes_value": {
                  "type": "boolean"
                },
                "repeatable": {
                  "type": "boolean"
                },
                "role": {
                  "enum": [
                    "input",
                    "account",
                    "confirmation",
                    "files",
                    "secret_value",
                    "output",
                    "interface",
                    "local_validation",
                    "local_credential"
                  ]
                },
                "mcp_input": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "api_field": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "api": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "path",
                "when",
                "account_header"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/v0(/(:[a-z_]+|[a-z-]+))+$"
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "account_header": {
                  "type": "boolean"
                }
              }
            }
          },
          "permission": {
            "enum": [
              "none",
              "user",
              "account.read",
              "apps.read",
              "apps.create",
              "apps.publish",
              "apps.delete",
              "apps.rollback",
              "secrets.write",
              "app_admin_invites.create",
              "apps.export"
            ]
          },
          "safeguards": {
            "type": "array",
            "items": {
              "enum": [
                "confirm_without_terminal",
                "selected_account_guard",
                "secret_name_check",
                "file_safety",
                "path_segment_check",
                "invite_expiry_range",
                "plan_key_check"
              ]
            }
          },
          "mcp": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "via",
                  "tool",
                  "status"
                ],
                "properties": {
                  "via": {
                    "const": "tool"
                  },
                  "tool": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "status": {
                    "const": "planned"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "via",
                  "status",
                  "note"
                ],
                "properties": {
                  "via": {
                    "const": "connection"
                  },
                  "status": {
                    "const": "planned"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "via",
                  "counterparts",
                  "note"
                ],
                "properties": {
                  "via": {
                    "const": "local_credential"
                  },
                  "counterparts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z_]+\\.[a-z_]+$"
                    }
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
